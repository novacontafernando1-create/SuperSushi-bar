<script>
    function updateSlug(val) {
      const slugInput = document.getElementById('input-slug');
      if (!slugInput) return;
      const slug = val
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      slugInput.value = slug || 'categoria';
    }

    function openSafeguardModal(categoryName, productCount) {
      const modal = document.getElementById('safeguard-modal');
      const dialog = document.getElementById('safeguard-dialog');
      const title = document.getElementById('modal-target-title');
      const count = document.getElementById('modal-product-count');

      title.textContent = `Remover "${categoryName}"`;
      count.textContent = productCount;

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        dialog.classList.remove('scale-95');
        dialog.classList.add('scale-100');
      }, 10);
    }

    function closeSafeguardModal() {
      const modal = document.getElementById('safeguard-modal');
      const dialog = document.getElementById('safeguard-dialog');
      
      modal.classList.add('opacity-0');
      dialog.classList.remove('scale-100');
      dialog.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    function confirmSafeguardAction() {
      closeSafeguardModal();
      showToast('Produtos migrados e categoria removida com segurança!', 'done_all');
    }

    function handleSaveCategory() {
      const nome = document.getElementById('input-nome').value;
      showToast(`Categoria "${nome}" salva com sucesso!`, 'check_circle');
    }

    function showToast(message, icon) {
      const toast = document.getElementById('toast-feedback');
      const toastMsg = document.getElementById('toast-message');
      const toastIcon = document.getElementById('toast-icon');

      toastMsg.textContent = message;
      toastIcon.textContent = icon || 'check_circle';

      toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      }, 3500);
    }
