<!-- Interactive script for active tabs & switches -->
<script>
    function switchTab(evt, tabId) {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-[0_0_20px_rgba(255,122,26,0.35)]');
        btn.classList.add('text-on-surface-variant', 'hover:bg-surface-container', 'hover:text-on-surface');
      });
      evt.currentTarget.classList.remove('text-on-surface-variant', 'hover:bg-surface-container', 'hover:text-on-surface');
      evt.currentTarget.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-[0_0_20px_rgba(255,122,26,0.35)]');
      
      const sections = ['section-identidade', 'section-canais', 'section-cardapio', 'section-equipe'];
      sections.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.remove('ring-1', 'ring-secondary');
      });
      const target = document.getElementById('section-' + tabId);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        target.classList.add('ring-1', 'ring-secondary');
        setTimeout(() => target.classList.remove('ring-1', 'ring-secondary'), 1600);
      }
    }

    function toggleSwitch(id) {
      const pill = document.getElementById(id + '-pill');
      const dot = document.getElementById(id + '-dot');
      const isChecked = pill.getAttribute('data-checked') === 'true';
      if (isChecked) {
        pill.setAttribute('data-checked', 'false');
        pill.classList.remove('bg-primary-container');
        pill.classList.add('bg-surface-container-high');
        dot.classList.remove('translate-x-5', 'bg-surface-container-lowest');
        dot.classList.add('translate-x-0', 'bg-on-surface-variant');
      } else {
        pill.setAttribute('data-checked', 'true');
        pill.classList.remove('bg-surface-container-high');
        pill.classList.add('bg-primary-container');
        dot.classList.remove('translate-x-0', 'bg-on-surface-variant');
        dot.classList.add('translate-x-5', 'bg-surface-container-lowest');
      }
    }
  </script>
